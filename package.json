{
  "name": "inhouse-ops",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "tsc -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute inhouse-ops --file=./schema.sql --remote",
    "prove:gmail": "node prove/gmail.mjs",
    "prove:quo": "node prove/quo.mjs",
    "prove:triage": "node prove/triage.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.131.1"
  }
}
